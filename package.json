{
  "name": "hunkpad",
  "private": true,
  "version": "0.4.0",
  "description": "Lightweight Git client with VS Code-quality diffs, for Windows, macOS and Linux",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --config demo/vite.config.ts",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "version": "node scripts/sync-version.mjs && git add src-tauri/Cargo.toml",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "monaco-editor": "^0.52.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
